# Private local self-hosted defaults. Console owner setup is required.
# Hosted configuration reference: infra/docker/hosted.env.example.
OPEN_COMMERCE_ENVIRONMENT=local_demo
OPEN_COMMERCE_RUNTIME_PROFILE=self_hosted
# Set a random base64-encoded 32-byte key for encrypted imports and login state.
OPEN_COMMERCE_ENCRYPTION_KEY=
OPEN_COMMERCE_APP_NAME=Open Commerce Agent
OPEN_COMMERCE_LOG_LEVEL=INFO
OPEN_COMMERCE_DATABASE_URL=postgresql+asyncpg://opencommerce:opencommerce@localhost:5432/opencommerce
OPEN_COMMERCE_REDIS_URL=redis://localhost:6379/0
OPEN_COMMERCE_QDRANT_URL=http://localhost:6333
OPEN_COMMERCE_MANAGER_PERIODIC_MEMORY_TURNS=6
# Manager conversation is credential-free and deterministic by default.
# To opt into OpenAI locally, set the provider to openai and put the key only in .env.
OPEN_COMMERCE_MANAGER_MODEL_PROVIDER=deterministic
OPEN_COMMERCE_MANAGER_MODEL_ID=gpt-5.4-mini
OPEN_COMMERCE_MANAGER_MODEL_TIMEOUT_SECONDS=45
OPEN_COMMERCE_MANAGER_MODEL_MAX_ITERATIONS=12
OPEN_COMMERCE_MANAGER_MODEL_MAX_TOOL_CALLS=10
OPEN_COMMERCE_MANAGER_MODEL_MAX_OUTPUT_TOKENS=2048
OPEN_COMMERCE_MANAGER_MODEL_MAX_INPUT_BYTES=64000
OPEN_COMMERCE_MANAGER_RUN_ACTIVE_SECONDS=300
OPEN_COMMERCE_MANAGER_WEB_HEALTH_URL=http://127.0.0.1:3000/health
OPEN_COMMERCE_SHOPPER_WEB_HEALTH_URL=http://127.0.0.1:3001/health
OPEN_COMMERCE_SHOPPER_SESSION_DAYS=7
OPEN_COMMERCE_OPENAI_API_KEY=
OPEN_COMMERCE_READINESS_TIMEOUT_SECONDS=2.0
OPEN_COMMERCE_CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
OPEN_COMMERCE_API_BASE_URL=http://localhost:8000
SHOPPER_PORT=3001

# Optional host-process controller model planning only. This remains local-only and
# is separate from the manager conversation provider above.
OPEN_COMMERCE_MODEL_ENABLED=false
OPEN_COMMERCE_MODEL_LOCAL_ONLY_ATTESTED=false
OPEN_COMMERCE_MODEL_URL=http://127.0.0.1:11434
OPEN_COMMERCE_MODEL_ID=qwen3:4b
OPEN_COMMERCE_MODEL_DIGEST=
OPEN_COMMERCE_MODEL_MAX_ITERATIONS=4
OPEN_COMMERCE_MODEL_MAX_TOOL_CALLS=3
OPEN_COMMERCE_MODEL_MAX_OUTPUT_TOKENS=1024
OPEN_COMMERCE_MODEL_MAX_INPUT_BYTES=16000
OPEN_COMMERCE_MODEL_TIMEOUT_SECONDS=60
OPEN_COMMERCE_MODEL_GOAL_REQUEST_LIMIT=40
OPEN_COMMERCE_MODEL_GOAL_TOKEN_LIMIT=720000
OPEN_COMMERCE_MODEL_DAILY_REQUEST_LIMIT=150
OPEN_COMMERCE_MODEL_DAILY_TOKEN_LIMIT=2700000
# Optional private read-only Shopify catalog pilot. Never paste tokens into chat.
OPEN_COMMERCE_SHOPIFY_CATALOG_ENABLED=false
# OPEN_COMMERCE_SHOPIFY_SHOP_DOMAIN=your-test-store.myshopify.com
# OPEN_COMMERCE_SHOPIFY_ADMIN_ACCESS_TOKEN=
