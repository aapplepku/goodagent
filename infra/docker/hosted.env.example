# Configuration reference only, not a deployment or production qualification.
# Merge into the deployment's secret store or ignored .env, never commit real values.
OPEN_COMMERCE_RUNTIME_PROFILE=hosted
OPEN_COMMERCE_ENVIRONMENT=development
OPEN_COMMERCE_ENCRYPTION_KEY=
OPEN_COMMERCE_OIDC_ISSUER=https://identity.example.invalid
OPEN_COMMERCE_OIDC_CLIENT_ID=
OPEN_COMMERCE_OIDC_CLIENT_SECRET=
OPEN_COMMERCE_OIDC_CALLBACK_URL=https://manage.example.invalid/api/runtime/v1/merchant/auth/oidc/callback
OPEN_COMMERCE_PUBLIC_ORIGINS=["https://manage.example.invalid","https://shop.example.invalid"]
OPEN_COMMERCE_PUBLIC_HOSTS=["manage.example.invalid","shop.example.invalid"]
OPEN_COMMERCE_SHOPPER_PUBLIC_URL=https://shop.example.invalid
# Review these deployment-wide ceilings before enabling a hosted model.
OPEN_COMMERCE_HOSTED_DAILY_REQUEST_LIMIT=1000
OPEN_COMMERCE_HOSTED_DAILY_TOKEN_LIMIT=5000000
OPEN_COMMERCE_MODEL_DAILY_REQUEST_LIMIT=150
OPEN_COMMERCE_MODEL_DAILY_TOKEN_LIMIT=2700000
OPEN_COMMERCE_MANAGER_MODEL_PROVIDER=openai
OPEN_COMMERCE_MANAGER_MODEL_ID=gpt-5.4-mini
OPEN_COMMERCE_OPENAI_API_KEY=
OPEN_COMMERCE_MODEL_ENABLED=false
OPEN_COMMERCE_LOCAL_OPERATIONS_ENABLED=false
OPEN_COMMERCE_SHOPIFY_CATALOG_ENABLED=false
