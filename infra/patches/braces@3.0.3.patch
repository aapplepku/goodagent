 'use strict';
 
+// Local security patch: bound recursive walkers independently of caller options.
+exports.checkDepth = depth => {
+  if (depth > 128) {
+    throw new RangeError('braces nesting depth exceeds limit (128)');
+  }
+};
+
+exports.validateOptions = options => {
+  for (const name of ['step', 'rangeLimit', 'relaxZeros', 'shorthand', 'capture', 'wrap']) {
+    const value = options[name];
+    if (value != null && !['string', 'number', 'boolean'].includes(typeof value)) {
+      throw new TypeError(`braces option ${name} must be a primitive`);
+    }
+  }
+};
+
+// Only child edges are walked: ordinary parser ASTs contain parent/prev backreferences.
+exports.validateAst = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  const seen = new Set();
+  while (pending.length) {
+    const { node, depth } = pending.pop();
+    exports.checkDepth(depth);
+    if (!node || typeof node !== 'object' || Array.isArray(node)) {
+      throw new TypeError('braces AST nodes must be objects');
+    }
+    if (seen.has(node)) {
+      throw new RangeError('braces AST must be an acyclic tree');
+    }
+    seen.add(node);
+    if (seen.size > 20000) {
+      throw new RangeError('braces AST traversal exceeds limit (20000)');
+    }
+    if (node.value !== undefined && typeof node.value !== 'string') {
+      throw new TypeError('braces AST values must be strings');
+    }
+    for (const name of ['ranges', 'commas']) {
+      if (node[name] !== undefined && typeof node[name] !== 'number') {
+        throw new TypeError(`braces AST ${name} must be numeric`);
+      }
+    }
+    if (node.nodes !== undefined) {
+      if (!Array.isArray(node.nodes)) {
+        throw new TypeError('braces AST children must be an array');
+      }
+      if (node.nodes.length > 20000 - seen.size - pending.length) {
+        throw new RangeError('braces AST traversal exceeds limit (20000)');
+      }
+      for (const child of node.nodes) pending.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
